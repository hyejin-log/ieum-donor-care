# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 Git에 올리지 않습니다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donor_care
DB_USER=postgres
DB_PASSWORD=

# 안내 Agent의 LLM
#   ollama : 내 컴퓨터의 무료 모델 (기록이 밖으로 나가지 않음, 느림)
#   groq   : Groq 클라우드 무료 등급 (빠름, 자료가 외부로 전송됨)
#   anthropic : Claude API (유료)   ·   demo : 규칙 답변만
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
