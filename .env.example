# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 Git에 올리지 않습니다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donor_care
DB_USER=postgres
DB_PASSWORD=

# 안내 Agent의 LLM
#   ollama : 내 컴퓨터의 무료 모델 (기록이 밖으로 나가지 않음, 느림)
#   groq   : Groq 클라우드 무료 등급 (빠름, 자료가 외부로 전송됨)
#   anthropic : Claude API (유료)   ·   demo : 규칙 답변만
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 로그인: 의료진 회원가입 때 넣는 병원 가입 코드 (비워 두면 의료진 가입이 닫힙니다)
STAFF_INVITE_CODE=

# EMR 연동 (FHIR)
#   비워 두면 모의 EMR(가상 자료)을 씁니다.
#   예: EMR_FHIR_BASE=http://127.0.0.1:8000/mock-emr/fhir  (HTTP로 모의 EMR 호출)
EMR_FHIR_BASE=
EMR_FHIR_TOKEN=
#   몇 분마다 자동으로 가져올지 (0 = 끔, 버튼으로만)
EMR_SYNC_MINUTES=0

# 상담사 연결: 공여자 화면의 "바로 전화하기" 버튼 (비우면 버튼 없이 상담 요청만)
CENTER_PHONE=
CENTER_HOURS=평일 09:00 ~ 17:00

# ---------- 배포(Vercel)에서만 ----------
# DATABASE_URL=postgresql://...  (Neon 연결 주소, 있으면 DB_HOST 등 대신 이것을 씀)
# DEMO_RESET=1        매일 새벽 데모 자료를 처음 상태로 (시연용 사이트에서만!)
# DEMO_PASSWORD=      데모 계정(demo_donor, demo_staff) 비밀번호
# CRON_SECRET=        매일 작업(/cron/daily)을 Vercel만 부를 수 있게 하는 임의 문자열 (16자 이상)
