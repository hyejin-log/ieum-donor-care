# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 Git에 올리지 않습니다)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donor_care
DB_USER=postgres
DB_PASSWORD=

# 안내 Agent의 LLM: ollama(무료, 내 컴퓨터) | anthropic(유료 Claude API) | demo(규칙 답변)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# LLM_PROVIDER=anthropic 일 때만
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
